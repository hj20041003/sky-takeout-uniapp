.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}

.coupon {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.left {
  width: 190rpx;
  background: linear-gradient(135deg, #e95f3c, #f0855e);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0;
}

.value {
  display: flex;
  align-items: baseline;
}

.rmb {
  font-size: 26rpx;
  margin-right: 4rpx;
}

.num {
  font-size: 52rpx;
  font-weight: bold;
}

.unit {
  font-size: 30rpx;
  margin-left: 4rpx;
}

.threshold {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

.right {
  flex: 1;
  padding: 26rpx 26rpx;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.save {
  font-size: 24rpx;
  color: #e95f3c;
  margin-top: 8rpx;
  font-weight: bold;
}

.pick {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: #e95f3c;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

.no-coupon {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 0;
  margin-top: 16rpx;
}
