.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #e95f3c;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #e95f3c;
  border-radius: 6rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 180rpx;
}

.go-btn {
  display: inline-block;
  margin-top: 40rpx;
  color: #fff;
  background: #e95f3c;
  font-size: 26rpx;
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
}

.coupon {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.coupon.gray .left {
  background: linear-gradient(135deg, #b8b8b8, #d0d0d0);
}

.coupon.gray .name,
.coupon.gray .value {
  color: #999;
}

.left {
  width: 190rpx;
  background: linear-gradient(135deg, #e95f3c, #f0855e);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0;
}

.value {
  display: flex;
  align-items: baseline;
  color: #fff;
}

.rmb {
  font-size: 26rpx;
  margin-right: 4rpx;
}

.num {
  font-size: 52rpx;
  font-weight: bold;
}

.unit {
  font-size: 30rpx;
  margin-left: 4rpx;
}

.threshold {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

.right {
  flex: 1;
  padding: 26rpx 26rpx;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.stamp {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 20rpx;
  color: #e95f3c;
  border: 2rpx solid #e95f3c;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  transform: rotate(12deg);
}

.coupon.gray .stamp {
  color: #999;
  border-color: #999;
}
