.page {
  padding: 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}
.head {
  background: linear-gradient(90deg, #e95f3c, #f0851a);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
}
.tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}
.rank-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}
.rank-num {
  width: 52rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #bbb;
  text-align: center;
  flex-shrink: 0;
}
.rank-num.top1 { color: #f5a623; }
.rank-num.top2 { color: #9aa7b1; }
.rank-num.top3 { color: #c98850; }
.rank-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}
.rank-info {
  flex: 1;
  margin-left: 22rpx;
}
.rank-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.rank-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}
.rank-meta .score {
  color: #ff9800;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.rank-meta .sales {
  color: #999;
  font-size: 24rpx;
}
.rank-price {
  margin-top: 8rpx;
  color: #e95f3c;
  font-size: 30rpx;
  font-weight: bold;
}
.bottom-entry {
  text-align: center;
  color: #e95f3c;
  font-size: 28rpx;
  padding: 30rpx 0 10rpx;
}
