<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索菜品名称" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="doSearch" />
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>
  <view class="hot-entry" bindtap="goHot">
    <text>🔥 热销榜 · 看看大家都在吃什么</text>
    <text class="arrow">›</text>
  </view>

  <view wx:if="{{loading}}" class="tip">搜索中...</view>

  <block wx:if="{{searched && !loading}}">
    <view wx:if="{{list.length === 0}}" class="tip">没有找到相关菜品</view>
    <view class="dish-item" wx:for="{{list}}" wx:key="id">
      <image class="dish-img" src="{{item.image}}" mode="aspectFill"></image>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-desc">{{item.description}}</view>
        <view class="dish-meta">
          <text wx:if="{{item.avgScore}}" class="score">★ {{item.avgScore}}分</text>
          <text wx:if="{{item.stock === 0}}" class="soldout">已售罄</text>
          <text wx:elif="{{item.stock !== null && item.stock <= 10}}" class="lowstock">仅剩{{item.stock}}份</text>
        </view>
        <view class="dish-bottom">
          <text class="price">¥{{item.price}}</text>
          <view class="add-btn {{item.stock === 0 ? 'disabled' : ''}}" data-id="{{item.id}}" data-soldout="{{item.stock === 0}}" bindtap="addCart">＋加入</view>
        </view>
      </view>
    </view>
  </block>
</view>
