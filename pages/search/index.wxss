.page {
  padding: 20rpx 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}
.search-btn {
  margin-left: 20rpx;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #e95f3c;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.hot-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7f0;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #e95f3c;
}
.hot-entry .arrow {
  color: #e95f3c;
  font-size: 36rpx;
}
.tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}
.dish-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.dish-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}
.dish-info {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}
.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.dish-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}
.dish-meta .score {
  color: #ff9800;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.dish-meta .soldout {
  color: #999;
  font-size: 22rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.dish-meta .lowstock {
  color: #e95f3c;
  font-size: 22rpx;
}
.dish-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.price {
  color: #e95f3c;
  font-size: 32rpx;
  font-weight: bold;
}
.add-btn {
  background: #e95f3c;
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}
.add-btn.disabled {
  background: #ccc;
}
