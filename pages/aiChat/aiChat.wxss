.ai-page {
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.msg-box {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.row {
  display: flex;
  margin-bottom: 24rpx;
}

.row.user {
  justify-content: flex-end;
}

.row.ai {
  justify-content: flex-start;
}

.bubble {
  max-width: 74%;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  border-radius: 20rpx;
  word-break: break-all;
}

.bubble.user {
  background: #e95f3c;
  color: #ffffff;
  border-bottom-right-radius: 6rpx;
}

.bubble.ai {
  background: #ffffff;
  color: #333333;
  border: 1rpx solid #e5e6eb;
  border-bottom-left-radius: 6rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e6eb;
}

.ipt {
  flex: 1;
  height: 72rpx;
  padding: 0 26rpx;
  background: #f5f6f8;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn {
  margin: 0 0 0 16rpx;
  width: 150rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  background: #e95f3c;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.btn[disabled] {
  background: #f0b6a8;
  color: #ffffff;
}
