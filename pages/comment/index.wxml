<view class="page">
  <block wx:if="{{existing}}">
    <view class="card">
      <view class="title">我的评价</view>
      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{existing.score >= item ? 'on' : ''}}">★</text>
      </view>
      <view class="content">{{existing.content || '未填写内容'}}</view>
      <view class="time">{{existing.createTime}}</view>
    </view>
    <view class="card" wx:if="{{existing.reply}}">
      <view class="title">商家回复</view>
      <view class="content">{{existing.reply}}</view>
    </view>
  </block>
  <block wx:else>
    <view class="card">
      <view class="title">给这单餐品打个分吧</view>
      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-score="{{item}}" bindtap="pickStar" class="star {{score >= item ? 'on' : ''}}">★</text>
      </view>
      <view class="score-text">{{score === 0 ? '点击星星评分' : score + ' 分'}}</view>
      <textarea class="content-input" placeholder="说说你的用餐体验（选填）" value="{{content}}" bindinput="onContentInput" maxlength="200"></textarea>
      <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中...' : '发布评价'}}</button>
    </view>
  </block>
</view>
