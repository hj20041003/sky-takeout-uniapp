.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.link {
  font-size: 26rpx;
  color: #e95f3c;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}

.coupon {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.left {
  width: 210rpx;
  background: linear-gradient(135deg, #e95f3c, #f0855e);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.value {
  display: flex;
  align-items: baseline;
}

.rmb {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.num {
  font-size: 56rpx;
  font-weight: bold;
}

.unit {
  font-size: 32rpx;
  margin-left: 4rpx;
}

.threshold {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.right {
  flex: 1;
  padding: 24rpx 28rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

.progress-wrap {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.progress {
  width: 200rpx;
  height: 10rpx;
  background: #eee;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar {
  height: 100%;
  background: #e95f3c;
  border-radius: 6rpx;
}

.progress-text {
  font-size: 20rpx;
  color: #999;
  margin-left: 12rpx;
}

.btn {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  background: #e95f3c;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

.btn.received {
  background: #ddd;
  color: #999;
}

.right {
  position: relative;
}
