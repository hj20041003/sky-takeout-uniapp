<view class="page">
  <view class="header">
    <text class="title">领券中心</text>
    <text class="link" bindtap="goMyCoupon">我的优惠券 ></text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <view wx:elif="{{list.length === 0}}" class="empty">暂无可领取的优惠券</view>

  <block wx:else>
    <view class="coupon" wx:for="{{list}}" wx:key="id">
      <view class="left">
        <block wx:if="{{item.type === 2}}">
          <view class="value"><text class="num">{{item.discountAmount}}</text><text class="unit">折</text></view>
        </block>
        <block wx:else>
          <view class="value"><text class="rmb">¥</text><text class="num">{{item.discountAmount}}</text></view>
        </block>
        <view class="threshold" wx:if="{{item.type === 1}}">满{{item.thresholdAmount}}可用</view>
        <view class="threshold" wx:elif="{{item.type === 3}}">无门槛</view>
        <view class="threshold" wx:else>折扣券</view>
      </view>
      <view class="right">
        <view class="name">{{item.name}}</view>
        <view class="info">限量{{item.totalCount}}张 · 每人限领{{item.limitPerUser}}张</view>
        <view class="time">有效期至 {{item.useEndTime}}</view>
        <view class="progress-wrap">
          <view class="progress"><view class="bar" style="width: {{item.totalCount > 0 ? (item.receivedCount / item.totalCount * 100) : 100}}%"></view></view>
          <text class="progress-text">已领{{item.receivedCount || 0}}/{{item.totalCount}}</text>
        </view>
        <view wx:if="{{receivedMap[item.id]}}" class="btn received">已领取</view>
        <view wx:else class="btn" data-id="{{item.id}}" bindtap="onReceive">立即领取</view>
      </view>
    </view>
  </block>
</view>
