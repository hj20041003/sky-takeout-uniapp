.page {
  padding: 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.label {
  font-size: 28rpx;
  color: #333;
}
.amount {
  margin-left: 24rpx;
  color: #e95f3c;
  font-size: 36rpx;
  font-weight: bold;
}
.reason-input {
  width: 100%;
  height: 220rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.submit-btn {
  margin-top: 40rpx;
  background: #e95f3c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.submit-btn[disabled] {
  background: #f0a08c;
  color: #fff;
}
.tip {
  margin-top: 30rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
.status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
}
.status-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff9800;
  margin-bottom: 24rpx;
}
.status-title.done {
  color: #07c160;
}
.status-title.rejected {
  color: #e64340;
}
.status-reason {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  text-align: left;
}
.status-amount {
  font-size: 28rpx;
  color: #e95f3c;
  margin-top: 20rpx;
  font-weight: bold;
}
